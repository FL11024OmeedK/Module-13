EXPO_PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app
DB_PASSWORD=your_rdelivery_app_mysql_password

# Optional — notification extra miles. Spring relaxed binding maps these to
# twilio.account-sid etc. (dashes removed). start-backend.sh sources this file,
# so setting them here is enough; never put real values in application.properties.
# TWILIO_ACCOUNTSID=your-twilio-account-sid
# TWILIO_AUTHTOKEN=your-twilio-auth-token
# TWILIO_FROMNUMBER=+1XXXXXXXXXX
# NOTIFY_CLIENTID=your-notify-client-id
# NOTIFY_SECRETKEY=your-notify-secret-key
# NOTIFY_TEMPLATEID=your-template-notification-type-name
